{
  "manifest_version": 3,
  "name": "Page Notes",
  "version": "1.0.0",
  "description": "Adds small page-side notes for personal reading.",
  "host_permissions": [
    "https://joker67.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "banks/pm07_content_management_systems_quiz_bank.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
